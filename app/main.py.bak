from fastapi import FastAPI

app = FastAPI()

@app.get("/")
def root():
    return {"message": "Server not running"}



@app.get("/divide")
def divide():
    try:
        result = 10 / 0
    except ZeroDivisionError:
        return {"error": "Cannot divide by zero"}
    return {"result": result}



@app.get("/debug")
def debug():
    x = 42
    return {"value": x}



@app.get("/concat")
def concat():
    a = 10
    return {"result": str(a) + "hello"}



@app.get("/list")
def list_error():
    arr = [1, 2, 3]
    try:
        value = arr[10]
    except IndexError:
        return {"error": "List index out of range"}
    return {"value": value}



@app.get("/dict")
def dict_error():
    data = {"name": "Ankita"}
    try:
        age = data["age"]
    except KeyError:
        return {"error": "Key 'age' not found in dictionary"}
    return {"age" age}